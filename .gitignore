# Ignore by directory or anchored path, never by a bare file name: a bare
# name matches in every directory and hides public files there. Private
# directories (.claude/, .pm/) stay unanchored so a nested one is ignored too.

# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
/bin/
/dist/

# Example binaries: a build in an example directory leaves a binary without
# an extension (cross-built ones too). Only sources are tracked there.
/examples/*/*
!/examples/*/*.go
!/examples/*/*.c
!/examples/*/*.h
!/examples/*/go.mod
!/examples/*/go.sum
!/examples/*/*.md

# Test artifacts, coverage, profiles
*.test
*.out
*.prof
coverage.*
profile.cov
/coverage/

# Dependency directories
/vendor/

# Go workspace file
go.work
go.work.sum

# Editor and tool leftovers, logs
*.swp
*.swo
*~
*.log

# IDE configurations
.idea/
.vscode/
*.code-workspace

# Environment files
.env
.env.local

# Build artifacts
*.o
*.a
/.gocache/

# Project-specific: a local docs generator config and its outputs in the root
/gops_config.yaml
/project_docs_*.md
/project_structure.txt
/docs/build/
/docs/_site/

# Private: temporary files, development docs, agent configuration, project
# management, tool state, reference clones (never tracked)
/tmp/
/docs/dev/
/docs/feature-requests/
.claude/
.pm/
/.goda/
/.goco/
/.gode/
/reference/

# Scratch files and experiments in the root
/test_*
/experiments/
/QUICK_START*.md
/RESEARCH*.md
